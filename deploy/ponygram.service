[Unit]
Description=Ponygram Telegram Bot
After=network.target

[Service]
Type=simple
User=ponygram
WorkingDirectory=/opt/ponygram
EnvironmentFile=/opt/ponygram/.env
ExecStart=/opt/ponygram/.venv/bin/python main.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ponygram

[Install]
WantedBy=multi-user.target

# Bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# Bot owner user ID (integer)
OWNER_ID=123456789

# Admin user IDs (comma-separated)
ADMIN_IDS=123456789,987654321

# Database URL
DATABASE_URL=sqlite+aiosqlite:///data/ponygram.db

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/ponygram.log

# Webhook settings (leave empty to use polling)
WEBHOOK_URL=
WEBHOOK_PORT=8443

# RSS poll interval in minutes (default: 15, min: 5)
RSS_INTERVAL=15

# Optional: TMDB API key (Phase 4)
TMDB_API_KEY=

# Optional: Last.fm API key (Phase 4)
LASTFM_API_KEY=

# Optional: Claude API key (Phase 6)
CLAUDE_API_KEY=
